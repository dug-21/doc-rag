# AgentDB Configuration
AGENTDB_HOST=localhost
AGENTDB_PORT=6333
AGENTDB_COLLECTION=technical_standards
AGENTDB_API_KEY=your-api-key-here

# Agentic-Flow Configuration
AGENTIC_FLOW_ENABLED=true
AGENTIC_FLOW_TOPOLOGY=mesh
AGENTIC_FLOW_MAX_AGENTS=8

# Neural Network Configuration
NEURAL_ENABLED=true
NEURAL_MODEL_PATH=./models/query-classifier.fann

# OpenAI API (for embeddings)
OPENAI_API_KEY=your-openai-api-key-here

# Redis Cache (optional)
REDIS_HOST=localhost
REDIS_PORT=6379

# Logging
LOG_LEVEL=info

# Performance
ACCURACY_THRESHOLD=0.97
LATENCY_TARGET_MS=600
